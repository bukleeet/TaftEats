<%- include('head', { title: review.title }) %>
<section class="container detail-layout"><a class="text-link" href="/establishments/<%= review.establishment._id %>/reviews">← <%= review.establishment.name %></a><article class="panel full-review"><div class="review-top"><span class="eyebrow">A STORY FROM <%= review.establishment.name %></span><span class="rating"><%- include('stars', { rating: review.rating }) %> <%= review.rating.toFixed(1) %> / 5</span></div><h1><%= review.title %></h1><p class="review-byline"><a href="/profile/<%= review.user %>">@<%= review.username %></a> · <%= formatDate(review.createdAt) %><%= review.edited ? ' · edited' : '' %></p><div class="rich-text"><%- review.body %></div><% if (review.media.length) { %><div class="media-grid"><% review.media.forEach(url => { %><% if (/\/(video)\//.test(url)) { %><video src="<%= url %>" controls preload="metadata" aria-label="Review video"></video><% } else { %><a href="<%= url %>" target="_blank" rel="noopener noreferrer"><img src="<%= url %>" alt="Photo attached to this review" loading="lazy"></a><% } %><% }) %></div><% } %><div class="vote-row"><span>Was this helpful?</span><button class="button secondary compact" type="button" data-vote="helpful" data-id="<%= review._id %>" aria-pressed="<%= review.userVote === 'helpful' %>" <%= !sessionUser || review.isReviewer ? 'disabled' : '' %>>Helpful · <%= review.helpfulCount %></button><button class="button secondary compact" type="button" data-vote="unhelpful" data-id="<%= review._id %>" aria-pressed="<%= review.userVote === 'unhelpful' %>" <%= !sessionUser || review.isReviewer ? 'disabled' : '' %>>Not helpful · <%= review.unhelpfulCount %></button><% if (!sessionUser) { %><a href="/login">Sign in to vote</a><% } %></div><% if (review.isReviewer) { %><details class="edit-section"><summary>Edit your review</summary><%- include('reviewForm', { action: '/reviews/' + review._id, method: 'PUT', review, establishment: null }) %></details><button class="text-button danger" type="button" data-delete-review="<%= review._id %>">Delete review</button><% } %></article>
<section class="conversation"><div class="section-heading"><div><p class="eyebrow">A LITTLE CONVERSATION</p><h2>At the same table</h2></div><span class="muted"><%= review.responseThread.length %> messages</span></div><% if (!review.responseThread.length) { %><div class="empty-state small-empty"><p>No replies yet. The restaurant owner can start the conversation.</p></div><% } %><% review.responseThread.forEach((msg, index) => { %><article class="thread-message"><div class="review-top"><strong><%= msg.author %> <span class="badge"><%= msg.role === 'owner' ? 'Restaurant owner' : 'Reviewer' %></span></strong><span class="muted"><%= formatDate(msg.createdAt) %><%= msg.edited ? ' · edited' : '' %></span></div><div class="rich-text"><%- msg.body %></div><% if (sessionUser && String(msg.authorId) === String(sessionUser._id) && (msg.role === 'owner' ? review.isOwner : review.isReviewer)) { %><details><summary>Edit message</summary><form data-api-form action="/reviews/<%= review._id %>/thread-message/<%= index %>" data-method="PUT" class="stack"><label for="message-<%= index %>">Message</label><textarea id="message-<%= index %>" name="body" rows="3" maxlength="10000" required><%= msg.body %></textarea><p class="form-message" role="alert" hidden></p><button class="button compact" type="submit">Save message</button></form></details><% if (index === review.responseThread.length - 1) { %><button class="text-button danger" type="button" data-delete-message="<%= review._id %>">Remove last message</button><% } %><% } %></article><% }) %>
<% const lastRole = review.responseThread.at(-1)?.role; const canReply = (review.isOwner && lastRole !== 'owner') || (review.isReviewer && lastRole === 'owner'); if (canReply) { %><form class="panel stack" data-api-form action="/reviews/<%= review._id %>/<%= review.isOwner ? 'owner-response' : 'reviewer-reply' %>" method="post"><label for="reply">Your reply</label><textarea id="reply" name="body" rows="4" maxlength="10000" placeholder="Continue the conversation…" required></textarea><p class="form-message" role="alert" hidden></p><button class="button" type="submit">Post reply ↗</button></form><% } %></section></section>
<%- include('foot') %>
