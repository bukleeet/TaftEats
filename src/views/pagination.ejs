<% if (pages > 1) { %>
<nav class="pagination" aria-label="Pagination">
  <% if (page > 1) { %><a class="button secondary" href="<%= pageUrl(page - 1) %>">← Previous</a><% } %>
  <span>Page <%= page %> of <%= pages %></span>
  <% if (page < pages) { %><a class="button secondary" href="<%= pageUrl(page + 1) %>">Next →</a><% } %>
</nav>
<% } %>
