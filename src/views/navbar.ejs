<%
  const user = typeof sessionUser !== 'undefined' ? sessionUser : null;
%>
<nav class="navbar">
  <div class="nav-left">
    <a href="/establishments" style="text-decoration:none;"><h2 class="logo">TaftEats</h2></a>
  </div>
  <div class="nav-right">
    <a href="/establishments" class="nav-link">Home</a>
    <a href="/about" class="nav-link">About</a>
    <a href="/reviews" class="nav-link">Reviews</a>
    <% if (user) { %>
      <a href="/profile/<%= user._id %>" class="nav-user-pill">
        <img src="/images/<%= user.avatar || 'defaultprofile.png' %>" alt="avatar" class="nav-avatar">
        <span><%= user.username %></span>
      </a>
      <form action="/logout" method="POST" style="display:inline;">
        <button type="submit" class="nav-btn login nav-logout-btn">Logout</button>
      </form>
    <% } else { %>
      <a href="/login" class="nav-btn login">Login</a>
      <a href="/register" class="nav-btn register">Register</a>
    <% } %>
    <button id="themeToggle" class="theme-btn">🌙</button>
  </div>
</nav>
