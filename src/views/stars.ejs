<span class="star-display" role="img" aria-label="<%= Number(rating).toFixed(1) %> out of 5 stars"><% for (let i = 0; i < 5; i++) { const fill = Math.min(1, Math.max(0, Number(rating) - i)); %><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path d="M12 2 15 8.5 22 9.5 17 14.5 18 22 12 18.5 6 22 7 14.5 2 9.5 9 8.5Z" fill="none" stroke="currentColor" stroke-width="1.5"/><svg width="<%= fill * 24 %>" height="24" class="star-fill"><path d="M12 2 15 8.5 22 9.5 17 14.5 18 22 12 18.5 6 22 7 14.5 2 9.5 9 8.5Z" fill="currentColor"/></svg></svg><% } %></span>
