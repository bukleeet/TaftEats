<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/profileEdit-style.css">
</head>
<body>

<!-- Navigation Bar -->
<nav class="navbar">
    <div class="nav-left">
        <h2 class="logo">TaftEats</h2>
    </div>
    <div class="nav-right">
        <button id="themeToggle" class="theme-btn">🌙</button>
    </div>
</nav>

<!-- Edit Profile -->
<div class="edit-profile-container">

    <!-- Edit Profile Form -->
    <div class="edit-form">
        <h1>Edit Profile</h1>

        <!-- Main Form Contents -->
        <div class="edit-inputs">
            <!-- Image Preview -->
            <div class="edit-profile-avatar">
                <img src="/images/<%= user.avatar || 'defaultprofile.png' %>" alt="current profile" />
                <div class="upload-overlay">
                    <span class="upload-icon">Upload</span>
                </div>
            </div>
            <input type="file" id="profileImage" accept="image/*" style="display:none;">

            <!-- Profile Info -->
            <div class="edit-info">
                <!-- Edit Username -->
                <div class="input-box">
                    <label for="username-txt" class="edit-label">Username</label>
                    <textarea type="text" id="username-txt" rows="1" placeholder="Enter your username" class="edit-input" required><%= user.username %></textarea>
                </div>

                <!-- Edit Description -->
                <div class="input-box">
                    <label for="desc-txt" class="edit-label">Description</label>
                    <textarea type="text" id="desc-txt" rows="4" name="" placeholder="Enter description" class="edit-input" required><%= user.description %></textarea>
                </div>
            </div>
        </div>

        <!-- Form Buttons -->
        <div class="edit-form-buttons">
            <!-- Submit Button -->
            <button type="submit" class="save-btn" onclick="saveEdits()">Save Changes</button>
            <a href="/profile/<%= user._id %>" class="discard-btn">Discard Changes</a>
        </div>
    </div>
</div>

<!-- Script to pass IDs to javascript  -->
<script>
    const userId = "<%= user._id %>";
</script>

<!-- Script for Profile Editing -->
<script src="/js/profileEdit-script.js"></script>
<script src="/js/theme-toggle.js"></script>

</body>
</html>
