<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Profile</title>
	<link rel="icon" type="image/png" href="https://res.cloudinary.com/ddbdnydcd/image/upload/v1774778894/favicon_vxcegg.png">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/profileEdit-style.css">
</head>
<body>

<!-- Navigation Bar (session-aware) -->
<%- include('navbar') %>

<!-- Edit Profile -->
<div class="edit-profile-container">

    <!-- Edit Profile Form -->
    <div class="edit-form">
        <h1>Edit Profile</h1>

        <!-- Main Form Contents -->
        <div class="edit-inputs">
            <!-- Image Preview -->
            <div class="edit-profile-avatar">
                <img src="<%= user.avatar || 'https://res.cloudinary.com/ddbdnydcd/image/upload/v1774355965/defaultprofile_aldk8t.webp' %>" alt="current profile" />
                <div class="upload-overlay">
                    <span class="upload-icon">Upload</span>
                </div>
            </div>
            <input type="file" id="profileImage" accept="image/*" style="display:none;">

            <!-- Profile Info -->
            <div class="edit-info">
                <!-- Edit Username -->
                <div class="input-box">
                    <label for="username-txt" class="edit-label">Username</label>
                    <textarea id="username-txt" rows="1" placeholder="Enter your username" class="edit-input" required><%= user.username %></textarea>
                </div>

                <!-- Edit Description -->
                <div class="input-box">
                    <label for="desc-txt" class="edit-label">Description</label>
                    <textarea id="desc-txt" rows="4" placeholder="Enter description" class="edit-input" required><%= user.description %></textarea>
                </div>
            </div>
        </div>

        <!-- Form Buttons -->
        <div class="edit-form-buttons">
            <button type="button" class="save-btn" onclick="saveEdits()">Save Changes</button>
            <a href="/profile/<%= user._id %>" class="discard-btn">Discard Changes</a>
        </div>
		
		<div class="danger-zone">
			<h3>Danger Zone</h3>
			<p>Once you delete your account, there is no going back. All of your reviews, comments, and uploaded photos will be permanently erased.</p>
			<button type="button" id="deleteAccountBtn" data-id="<%= user._id %>" class="danger-btn">Delete Account</button>
		</div>
    </div>
</div>

<!-- Pass userId to JS -->
<script>
    const userId = "<%= user._id %>";
	const deleteAccountBtn = document.getElementById('deleteAccountBtn');

if (deleteAccountBtn) {
    deleteAccountBtn.addEventListener('click', async function() {
        const userId = this.dataset.id;
        
        const confirmed = confirm('Are you absolutely sure you want to delete your account? This action cannot be undone.');
        if (!confirmed) return;

        // Two-step verification to prevent accidental misclicks
        const textCheck = prompt('Please type "DELETE" to confirm account deletion:');
        if (textCheck !== 'DELETE') {
            return alert('Account deletion cancelled.');
        }

        try {
            const res = await fetch(`/profile/${userId}/delete`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' }
            });
            
            const data = await res.json();

            if (data.success) {
                alert('Your account has been successfully deleted.');
                window.location.href = '/establishments'; 
            } else {
                alert(data.message || 'Failed to delete account.');
            }
        } catch (err) {
            console.error(err);
            alert('A network error occurred.');
        }
    });
}
</script>

<script src="/js/profileEdit-script.js"></script>
<script src="/js/theme-toggle.js"></script>

</body>
</html>
