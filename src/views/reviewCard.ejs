<article class="review-card">
  <div class="review-top">
    <a
      class="eyebrow"
      href="/establishments/<%= review.establishment?._id || review.establishment %>/reviews"
    >
      <%= review.establishment?.name || 'Restaurant' %>
    </a>
    <span class="rating" aria-label="<%= review.rating %> out of 5 stars">
      <%- include('stars', { rating: review.rating }) %> <%= review.rating.toFixed(1) %>
    </span>
  </div>

  <h3><a href="/reviews/<%= review._id %>"><%= review.title %></a></h3>

  <p class="review-byline">
    <a href="/profile/<%= review.user %>">@<%= review.username %></a> · <%= formatDate(review.createdAt) %><%= review.edited ? ' · edited' : '' %>
  </p>

  <div class="rich-text review-excerpt"><%- review.body %></div>

  <div class="review-bottom">
    <span class="muted"><%= review.helpfulCount %> found this helpful</span>
    <a class="text-link" href="/reviews/<%= review._id %>">Read the story ↗</a>
  </div>
</article>
