<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Profile</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/profileView-style.css">
</head>
<body>

<!-- Navigation Bar -->
<%- include('navbar') %>

<!-- View Profile -->
<div class="container profile-container">
        
    <!-- User Profile Header-->
    <div class="profile-content">
        <!-- Profile Image-->
        <div class="profile-left">
            <div class="profile-avatar">
                <img src="/images/<%= user.avatar || 'defaultprofile.png' %>" alt="user-profile">
            </div>

            <a href="/profile/<%= user._id %>/edit" class="edit-btn" id="editProfileBtn" style="display:none;"> Edit Profile </a>
        </div>
        <!-- Username & Description -->
        <div class="user-info">
            <h1 id="username-display"><%= user.username %></h1>
            <p id="desc-display">
                <%= user.description %>
            </p>
        </div>
    </div>

    <!-- User Activity -->
    <div class="activity-section">
        <!-- Activity Tabs -->
        <div class="activity-sidebar tabs">

            <!-- User Recent Activity -->
            <input type="radio" id="activity-tab" name="tabs" data-tab="recent-activity" checked>
            <label for="activity-tab" class="tab-label">Recent Activity</label>

            <!-- User All Reviews -->
            <input type="radio" id="posts-tab" name="tabs" data-tab="all-posts">
            <label for="posts-tab" class="tab-label">All Posts</label>

            <!-- User All Comments -->
            <input type="radio" id="comments-tab" name="tabs" data-tab="all-comments">
            <label for="comments-tab" class="tab-label">All Comments</label>
        </div>

        <!-- Activity Container -->
        <div class="activity-contents">

            <!-- Recent Activity Tab -->
            <div id="recent-activity" class="tab-content active">
                <p style="color:#6b7280;padding:1rem;">Loading activity...</p>
            </div>

            <!-- All Posts Tab -->
            <div id="all-posts" class="tab-content">
                <p style="color:#6b7280;padding:1rem;">Loading posts...</p>
            </div>

            <!-- All Comments Tab -->
            <div id="all-comments" class="tab-content">
                <p style="color:#6b7280;padding:1rem;">Loading comments...</p>
            </div>

        </div>
    </div>
</div>

<!-- Pass IDs safely to JS — guard against null sessionUser -->
<% const currentUser = typeof sessionUser !== 'undefined' ? sessionUser : null %>
<script>
    const viewedUserID  = "<%= user._id %>";
    const currentUserID = "<%= currentUser ? currentUser._id : '' %>";
</script>

<!-- Tab Navigation & Edit Button -->
<script src="/js/profileView-script.js"></script>
<script src="/js/theme-toggle.js"></script>

</body>
</html>
