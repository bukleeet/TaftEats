<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>View Profile</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/profileView-style.css">
</head>
<body>

<%- include('navbar') %>

<div class="container profile-container">

    <div class="profile-content">
        <div class="profile-left">
            <div class="profile-avatar">
                <img src="<%= user.avatar || 'https://res.cloudinary.com/ddbdnydcd/image/upload/v1774355965/defaultprofile_aldk8t.webp' %>" alt="user-profile">
            </div>
            <a href="/profile/<%= user._id %>/edit" class="edit-btn" id="editProfileBtn" style="display:none;">Edit Profile</a>
        </div>
        <div class="user-info">
            <h1 id="username-display"><%= user.username %></h1>
            <p id="desc-display"><%= user.description %></p>
        </div>
    </div>

    <div class="activity-section">
        <div class="activity-sidebar tabs">
            <input type="radio" id="activity-tab" name="tabs" data-tab="recent-activity" checked>
            <label for="activity-tab" class="tab-label">Recent Activity</label>

            <input type="radio" id="reviews-tab" name="tabs" data-tab="all-reviews">
            <label for="reviews-tab" class="tab-label">Reviews</label>

            <input type="radio" id="replies-tab" name="tabs" data-tab="all-replies">
            <label for="replies-tab" class="tab-label">Replies</label>
        </div>

        <div class="activity-contents">
            <div id="recent-activity" class="tab-content active">
                <p style="color:#6b7280;padding:1rem 0;">Loading...</p>
            </div>
            <div id="all-reviews" class="tab-content">
                <p style="color:#6b7280;padding:1rem 0;">Loading...</p>
            </div>
            <div id="all-replies" class="tab-content">
                <p style="color:#6b7280;padding:1rem 0;">Loading...</p>
            </div>
        </div>
    </div>
</div>

<% const currentUser = typeof sessionUser !== 'undefined' ? sessionUser : null %>
<script>
    const viewedUserID  = "<%= user._id %>";
    const currentUserID = "<%= currentUser ? currentUser._id : '' %>";
</script>

<script src="/js/profileView-script.js"></script>
<script src="/js/theme-toggle.js"></script>

</body>
</html>
