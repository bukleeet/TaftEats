<%- include('navbar') %>

<!-- Page Header -->
<header class="header">
  <h1>About TaftEats</h1>
  <p>Helping students eat better, one review at a time</p>
</header>

<main class="container">

  <div class="about-grid">

    <!-- Who We Are -->
    <section class="about-card">
      <div class="about-header">
        <span class="about-icon">👥</span>
        <h2>Who We Are</h2>
      </div>
      <p>
        TaftEats is a student-centered food discovery platform designed to help
        students and food lovers find honest, reliable restaurant recommendations
        around Taft Avenue. Built with accessibility and authenticity in mind,
        we prioritize real experiences over hype.
      </p>
    </section>

    <!-- Our Mission -->
    <section class="about-card">
      <div class="about-header">
        <span class="about-icon">🎯</span>
        <h2>Our Mission</h2>
      </div>
      <p>
        Our mission is to support informed dining decisions by providing a space
        where students can share genuine feedback. TaftEats aims to uplift local
        food establishments while helping users make choices that fit their taste,
        budget, and lifestyle.
      </p>
    </section>

    <!-- What We Offer -->
    <section class="about-card">
      <div class="about-header">
        <span class="about-icon">🍽️</span>
        <h2>What We Offer</h2>
      </div>
      <ul class="about-list">
        <li>Curated restaurants around Taft</li>
        <li>Student-written reviews and ratings</li>
        <li>Search and filter tools for convenience</li>
        <li>A platform built specifically for students</li>
      </ul>
    </section>

