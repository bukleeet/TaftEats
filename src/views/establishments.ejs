<%- include('head', { title: 'Find your next favorite' }) %>
<section class="hero container">
  <img class="hero-background" src="<%= assetUrls.hero %>" alt="" width="943" height="620" fetchpriority="high">
  <div class="hero-copy">
    <h1 aria-label="Are you hungry?"><span id="hero-text" lang="en" aria-hidden="true">Are you <em>hungry?</em></span><span class="hero-cursor" aria-hidden="true"></span></h1>
    <p class="hero-description">Discover restaurants around Taft</p>
    <div class="hero-actions"><a class="button" href="#discover">Explore Now</a><button class="hero-animation-toggle text-button" type="button" aria-pressed="false" hidden>Pause animation</button></div>
  </div>
</section>
<section class="discover container" id="discover">
  <div class="section-heading"><div><p class="eyebrow">YOUR NEXT GO-TO</p><h2>Explore the neighborhood</h2></div><span class="muted"><%= count %> <%= count === 1 ? 'place' : 'places' %> to discover</span></div>
  <form class="filter-bar" method="get" action="/establishments" role="search">
    <div class="search-field"><label class="sr-only" for="search">Search restaurants</label><span aria-hidden="true">⌕</span><input id="search" name="q" type="search" maxlength="80" placeholder="A place, a craving, a new favorite…" value="<%= q %>"></div>
    <% if (categories.length) { %><div><label class="sr-only" for="category">Category</label><select id="category" name="category"><option value="">All categories</option><% categories.forEach(c => { %><option value="<%= c %>" <%= category === c ? 'selected' : '' %>><%= c %></option><% }) %></select></div><% } %>
    <div><label class="sr-only" for="sort">Sort restaurants</label><select id="sort" name="sort"><option value="name" <%= sort === 'name' ? 'selected' : '' %>>Name: A–Z</option><option value="rating" <%= sort === 'rating' ? 'selected' : '' %>>Highest rated</option></select></div><button class="button compact" type="submit">Explore</button>
  </form>
  <% if (!establishments.length) { %><div class="empty-state"><span class="empty-symbol" aria-hidden="true">⌕</span><h3><%= q || category ? 'No places match just yet.' : 'The table is being set.' %></h3><p><%= q || category ? 'Try another search or explore all neighborhood places.' : 'Check back soon for restaurants from the community.' %></p><% if (q || category) { %><a class="button secondary" href="/establishments">Clear filters</a><% } %></div><% } %>
  <div class="restaurant-grid"><% establishments.forEach(est => { %>
    <article class="restaurant-card">
      <a class="restaurant-link" href="/establishments/<%= est._id %>/reviews" aria-labelledby="restaurant-<%= est._id %>">
        <div class="card-image"><img src="<%= mediaUrl(est.image) %>" alt="" loading="lazy" width="600" height="420"><% if (categories.includes(est.category)) { %><span class="image-label"><%= est.category %></span><% } %></div>
        <div class="card-content">
          <div class="card-title"><h3 id="restaurant-<%= est._id %>"><%= est.name %></h3><span class="card-arrow" aria-hidden="true">→</span></div>
          <p><%= est.description %></p>
          <div class="card-meta"><span class="rating"><%- include('stars', { rating: est.reviewCount ? est.rating : 0 }) %><span class="rating-details"><span><%= est.reviewCount ? est.rating.toFixed(1) : 'New' %></span><span class="muted">· <%= est.reviewCount %> <%= est.reviewCount === 1 ? 'review' : 'reviews' %></span></span></span></div>
        </div>
      </a>
    </article>
  <% }) %></div>
  <%- include('pagination', { page, pages, pageUrl: p => '/establishments?' + new URLSearchParams({ q, category, sort, page: p }) }) %>
</section>
<section class="community-banner container"><div><p class="eyebrow">THERE'S A SEAT FOR YOU</p><h2>Found something worth sharing?</h2><p>A great review can be someone's next great meal.</p></div><a class="button light" href="<%= sessionUser ? '/reviews' : '/register' %>"><%= sessionUser ? 'See the community' : 'Join the community' %> ↗</a></section>
<%- include('foot') %>
