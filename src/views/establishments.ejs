<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Establishments</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>

  <!-- Navigation -->
  <nav class="navbar">
    <div class="nav-left">
      <h2 class="logo">TaftEats</h2>
    </div>
    <div class="nav-right">
      <a href="/establishments" class="nav-link">Home</a>
      <a href="/about" class="nav-link">About</a>
      <a href="/reviews" class="nav-link">Reviews</a>
      <a href="/profile-view" class="nav-link">Profile</a>
      <a href="/login" class="nav-btn login" id="navLoginBtn">Login</a>
      <a href="/register" class="nav-btn register">Register</a>
      <button id="themeToggle" class="theme-btn">🌙</button>
    </div>
  </nav>

  <!-- Hero Section -->
  <header class="hero">
    <div class="hero-content">
      <h1 id="hero-text">Are you hungry?</h1>
      <p>Discover restaurants around Taft</p>
      <a href="#restaurants" class="hero-btn">Explore Now</a>
    </div>
  </header>

  <script>
    const heroText = document.getElementById("hero-text");
    const translations = [
      "Are you hungry?",
      "Gutom ka na ba?",
      "¿Tienes hambre?",
      "你饿了吗？",
      "Vous avez faim?",
      "Hast du Hunger?",
      "Hai fame?"
    ];
    let index = 0;
    setInterval(() => {
      index = (index + 1) % translations.length;
      heroText.textContent = translations[index];
    }, 3000);
  </script>

  <main class="container" id="restaurants">

    <!-- Search & Filter -->
    <div class="search-bar">
      <input type="text" id="searchInput" placeholder="Search establishments..." />
      <select id="ratingFilter">
        <option value="0">All Ratings</option>
        <option value="1">1 star</option>
        <option value="2">2 stars</option>
        <option value="3">3 stars</option>
        <option value="4">4 stars</option>
        <option value="5">5 stars</option>
      </select>
    </div>

    <!-- Dynamic Establishments -->
    <% if (establishments && establishments.length > 0) { %>
      <% establishments.forEach(est => { %>
        <div class="establishment-card" data-rating="<%= est.rating %>">
          <img src="/images/<%= est.image %>" alt="<%= est.name %>" class="establishment-img" />
          <div class="establishment-info">
            <h2><%= est.name %></h2>
            <p class="rating">⭐ <%= est.rating %> / 5</p>
            <p class="description"><%= est.description %></p>
            <a href="/reviews/<%= est._id %>" class="view-btn">View Reviews</a>
          </div>
        </div>
      <% }) %>
    <% } else { %>
      <p>No establishments found.</p>
    <% } %>

  </main>

  <!-- Scripts -->
  <script>
    const searchInput = document.getElementById("searchInput");
    const ratingFilter = document.getElementById("ratingFilter");
    const cards = document.querySelectorAll(".establishment-card");

    function filterEstablishments() {
      const searchText = searchInput.value.toLowerCase();
      const selectedRating = parseFloat(ratingFilter.value);

      cards.forEach(card => {
        const title = card.querySelector("h2").textContent.toLowerCase();
        const desc = card.querySelector(".description").textContent.toLowerCase();
        const rating = parseFloat(card.dataset.rating) || 0;

        const matchesSearch = title.includes(searchText) || desc.includes(searchText);
        let matchesRating = true;

        if (selectedRating === 1) matchesRating = rating >=1 && rating <2;
        if (selectedRating === 2) matchesRating = rating >=2 && rating <3;
        if (selectedRating === 3) matchesRating = rating >=3 && rating <4;
        if (selectedRating === 4) matchesRating = rating >=4 && rating <5;
        if (selectedRating === 5) matchesRating = rating ===5;

        card.style.display = matchesSearch && matchesRating ? "flex" : "none";
      });
    }

    searchInput.addEventListener("input", filterEstablishments);
    ratingFilter.addEventListener("change", filterEstablishments);
  </script>

  <script src="/js/loggedUser-script.js"></script>
  <script src="/js/theme-toggle.js"></script>

</body>
</html>