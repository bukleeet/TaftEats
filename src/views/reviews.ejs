<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= establishment ? establishment.name + ' - Reviews' : 'All Reviews' %> - TaftEats</title>
  <link rel="stylesheet" href="/css/style.css"/>
  <!-- DOMPurify for client-side sanitization in the rich-text editor -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.6/purify.min.js"></script>
</head>
<body>

<%- include('navbar') %>

<!-- Page Header -->
<div class="header" style="position:relative;">
  <h1><%= establishment ? establishment.name : 'All Reviews' %></h1>
  <p><%= establishment ? establishment.description : 'Browse all reviews' %></p>
  <% if (user) { %>
    <button class="review-btn" id="openReviewModal">+ Write a Review</button>
  <% } %>
</div>

<div class="container">

  <!-- Search bar -->
  <div class="search-bar">
    <input type="text" id="searchInput" placeholder="Search reviews…" />
  </div>

  <!-- Reviews list -->
  <div id="reviewsList">
    <% if (reviews.length === 0) { %>
      <p style="color:#6b7280;margin-top:2rem;">No reviews yet. Be the first!</p>
    <% } %>

    <% reviews.forEach(review => { %>
      <div class="review-card" data-id="<%= review._id %>"
           data-title="<%= review.title %>"
           data-rating="<%= review.rating %>">

        <!-- Review header -->
        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
          <div>
            <h3><%= review.title %></h3>
            <p class="review-meta">
              ⭐ <%= review.rating %>/5 &nbsp;·&nbsp;
              @<%= review.username %> &nbsp;·&nbsp;
              <%= new Date(review.createdAt).toLocaleDateString() %>
              <% if (review.edited) { %> <em style="font-size:0.8rem;">(edited)</em><% } %>
            </p>
          </div>

          <!-- Owner/Author actions -->
          <div style="display:flex;gap:0.5rem;">
            <% if (user && user._id.toString() === review.user.toString()) { %>
              <button class="secondary-btn edit-review-btn"
                      data-id="<%= review._id %>"
                      data-title="<%= review.title %>"
                      data-body="<%= encodeURIComponent(review.body) %>"
                      data-rating="<%= review.rating %>">Edit</button>
              <button class="secondary-btn delete-review-btn"
                      data-id="<%= review._id %>"
                      style="color:#ef4444;">Delete</button>
            <% } %>
          </div>
        </div>

        <!-- Body (safe HTML from server) -->
        <div class="review-text review-body-preview" style="max-height:120px;overflow:hidden;">
          <%- review.body %>
        </div>
        <a href="/reviews/<%= review._id %>" style="font-size:0.85rem;color:#16a34a;">Read full review →</a>

        <!-- Media -->
        <% if (review.media) { %>
          <% const isVideo = /\.(mp4|mov|webm)$/i.test(review.media); %>
          <% if (isVideo) { %>
            <video src="/uploads/<%= review.media %>" controls style="max-width:100%;border-radius:8px;margin-top:0.5rem;"></video>
          <% } else { %>
            <img src="/uploads/<%= review.media %>" alt="Review media" style="max-width:100%;border-radius:8px;margin-top:0.5rem;">
          <% } %>
        <% } %>

        <!-- Helpful / Unhelpful votes -->
        <div style="display:flex;gap:1rem;margin-top:1rem;align-items:center;">
          <button class="vote-btn <%=
              review.userVote === 'helpful' ? 'primary-btn' : 'secondary-btn'
            %>"
            data-id="<%= review._id %>" data-type="helpful"
            <%= !user ? 'disabled title="Login to vote"' : '' %>>
            👍 <span class="helpful-count"><%= review.helpfulCount %></span>
          </button>
          <button class="vote-btn <%=
              review.userVote === 'unhelpful' ? 'primary-btn' : 'secondary-btn'
            %>"
            data-id="<%= review._id %>" data-type="unhelpful"
            <%= !user ? 'disabled title="Login to vote"' : '' %>>
            👎 <span class="unhelpful-count"><%= review.unhelpfulCount %></span>
          </button>
        </div>

        <!-- Owner response -->
        <% if (review.ownerResponse) { %>
          <div class="owner-response">
            <strong>🏪 Owner's Response:</strong>
            <div><%- review.ownerResponse.body %></div>
            <small style="color:#6b7280;"><%= new Date(review.ownerResponse.respondedAt).toLocaleDateString() %></small>
            <% if (user && user.role === 'owner' && user.ownedEstablishment && establishment && user.ownedEstablishment.toString() === establishment._id.toString()) { %>
              <button class="secondary-btn delete-owner-response-btn"
                      data-id="<%= review._id %>"
                      style="font-size:0.8rem;margin-top:0.5rem;">Delete Response</button>
            <% } %>
          </div>
        <% } else if (user && user.role === 'owner' && establishment && user.ownedEstablishment && user.ownedEstablishment.toString() === establishment._id.toString()) { %>
          <button class="secondary-btn owner-respond-btn"
                  data-id="<%= review._id %>"
                  style="margin-top:0.75rem;font-size:0.9rem;">💬 Respond as Owner</button>
        <% } %>
      </div>
    <% }) %>
  </div>
</div>

<!-- ══════════════════════════════════════
     CREATE REVIEW MODAL
══════════════════════════════════════ -->
<div class="modal" id="reviewModal">
  <div class="modal-card" style="max-width:560px;">
    <h3 style="color:#065f46;margin-bottom:1rem;">Write a Review</h3>

    <input type="hidden" id="reviewEstablishmentId"
           value="<%= establishment ? establishment._id : '' %>">

    <input class="modal-input" id="reviewTitle" placeholder="Review title" maxlength="120" style="margin-bottom:0.75rem;">

    <!-- Star rating -->
    <div class="star-rating-container" id="starRating">
      <span class="star" data-value="1">★</span>
      <span class="star" data-value="2">★</span>
      <span class="star" data-value="3">★</span>
      <span class="star" data-value="4">★</span>
      <span class="star" data-value="5">★</span>
      <span id="ratingValueDisplay">0 / 5</span>
    </div>
    <input type="hidden" id="reviewRating" value="0">

    <!-- Rich text editor -->
    <div class="rich-editor-container" style="margin-bottom:0.75rem;">
      <div class="editor-toolbar">
        <button type="button" onclick="execCmd('bold')"><b>B</b></button>
        <button type="button" onclick="execCmd('italic')"><i>I</i></button>
        <button type="button" onclick="execCmd('underline')"><u>U</u></button>
        <button type="button" onclick="execCmd('strikeThrough')"><s>S</s></button>
        <button type="button" onclick="execCmd('insertUnorderedList')">• List</button>
        <button type="button" onclick="execCmd('insertOrderedList')">1. List</button>
      </div>
      <div class="editor-content" id="reviewBody" contenteditable="true"
           placeholder="Write your review here…"></div>
    </div>

    <!-- Media upload -->
    <div class="media-upload">
      <label class="upload-label" for="reviewMedia">📎 Attach photo/video</label>
      <input type="file" id="reviewMedia" accept="image/*,video/*" style="display:none;">
      <span id="mediaFilename" style="font-size:0.85rem;margin-left:0.5rem;color:#6b7280;"></span>
    </div>

    <div class="modal-actions">
      <button class="primary-btn"   id="submitReview">Post Review</button>
      <button class="secondary-btn" id="cancelReview">Cancel</button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════
     EDIT REVIEW MODAL
══════════════════════════════════════ -->
<div class="modal" id="editReviewModal">
  <div class="modal-card" style="max-width:560px;">
    <h3 style="color:#065f46;margin-bottom:1rem;">Edit Review</h3>
    <input type="hidden" id="editReviewId">

    <input class="modal-input" id="editReviewTitle" placeholder="Review title" maxlength="120" style="margin-bottom:0.75rem;">

    <div class="star-rating-container" id="editStarRating">
      <span class="star" data-value="1">★</span>
      <span class="star" data-value="2">★</span>
      <span class="star" data-value="3">★</span>
      <span class="star" data-value="4">★</span>
      <span class="star" data-value="5">★</span>
      <span id="editRatingValueDisplay">0 / 5</span>
    </div>
    <input type="hidden" id="editReviewRating" value="0">

    <div class="rich-editor-container" style="margin-bottom:0.75rem;">
      <div class="editor-toolbar">
        <button type="button" onclick="execEditCmd('bold')"><b>B</b></button>
        <button type="button" onclick="execEditCmd('italic')"><i>I</i></button>
        <button type="button" onclick="execEditCmd('underline')"><u>U</u></button>
        <button type="button" onclick="execEditCmd('strikeThrough')"><s>S</s></button>
        <button type="button" onclick="execEditCmd('insertUnorderedList')">• List</button>
        <button type="button" onclick="execEditCmd('insertOrderedList')">1. List</button>
      </div>
      <div class="editor-content" id="editReviewBody" contenteditable="true"></div>
    </div>

    <div class="media-upload">
      <label class="upload-label" for="editReviewMedia">📎 Replace photo/video</label>
      <input type="file" id="editReviewMedia" accept="image/*,video/*" style="display:none;">
      <span id="editMediaFilename" style="font-size:0.85rem;margin-left:0.5rem;color:#6b7280;"></span>
    </div>

    <div class="modal-actions">
      <button class="primary-btn"   id="submitEditReview">Save Changes</button>
      <button class="secondary-btn" id="cancelEditReview">Cancel</button>
    </div>
  </div>
</div>

<!-- ══════════════════════════════════════
     OWNER RESPONSE MODAL
══════════════════════════════════════ -->
<div class="modal" id="ownerResponseModal">
  <div class="modal-card" style="max-width:480px;">
    <h3 style="color:#065f46;margin-bottom:1rem;">Respond as Owner</h3>
    <input type="hidden" id="ownerResponseReviewId">
    <div class="rich-editor-container" style="margin-bottom:0.75rem;">
      <div class="editor-toolbar">
        <button type="button" onclick="execOwnerCmd('bold')"><b>B</b></button>
        <button type="button" onclick="execOwnerCmd('italic')"><i>I</i></button>
        <button type="button" onclick="execOwnerCmd('underline')"><u>U</u></button>
      </div>
      <div class="editor-content" id="ownerResponseBody" contenteditable="true"
           placeholder="Write your response…"></div>
    </div>
    <div class="modal-actions">
      <button class="primary-btn"   id="submitOwnerResponse">Post Response</button>
      <button class="secondary-btn" id="cancelOwnerResponse">Cancel</button>
    </div>
  </div>
</div>

<script>
// Rich text helpers
function execCmd(cmd) { document.execCommand(cmd, false, null); document.getElementById('reviewBody').focus(); }
function execEditCmd(cmd) { document.execCommand(cmd, false, null); document.getElementById('editReviewBody').focus(); }
function execOwnerCmd(cmd) { document.execCommand(cmd, false, null); document.getElementById('ownerResponseBody').focus(); }

// Star rating helper
function initStars(containerId, hiddenId, displayId) {
  const container = document.getElementById(containerId);
  const hidden    = document.getElementById(hiddenId);
  const display   = document.getElementById(displayId);
  if (!container) return;
  container.querySelectorAll('.star').forEach(star => {
    star.addEventListener('click', () => {
      const val = parseInt(star.dataset.value);
      hidden.value = val;
      display.textContent = val + ' / 5';
      container.querySelectorAll('.star').forEach(s => {
        s.style.color = parseInt(s.dataset.value) <= val ? '#fbbf24' : '#ccc';
      });
    });
    star.addEventListener('mouseenter', () => {
      const val = parseInt(star.dataset.value);
      container.querySelectorAll('.star').forEach(s => {
        s.style.color = parseInt(s.dataset.value) <= val ? '#fbbf24' : '#ccc';
      });
    });
    star.addEventListener('mouseleave', () => {
      const current = parseInt(hidden.value) || 0;
      container.querySelectorAll('.star').forEach(s => {
        s.style.color = parseInt(s.dataset.value) <= current ? '#fbbf24' : '#ccc';
      });
    });
  });
}
initStars('starRating', 'reviewRating', 'ratingValueDisplay');
initStars('editStarRating', 'editReviewRating', 'editRatingValueDisplay');

// Modal helpers
function openModal(id)  { document.getElementById(id).classList.add('active'); }
function closeModal(id) { document.getElementById(id).classList.remove('active'); }

// Open create modal
const openBtn = document.getElementById('openReviewModal');
if (openBtn) openBtn.addEventListener('click', () => openModal('reviewModal'));
document.getElementById('cancelReview').addEventListener('click', () => closeModal('reviewModal'));
document.getElementById('cancelEditReview').addEventListener('click', () => closeModal('editReviewModal'));

const cancelOwner = document.getElementById('cancelOwnerResponse');
if (cancelOwner) cancelOwner.addEventListener('click', () => closeModal('ownerResponseModal'));

// Close on backdrop click
['reviewModal','editReviewModal','ownerResponseModal'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener('click', e => { if (e.target === el) closeModal(id); });
});

// Media filename display
document.getElementById('reviewMedia').addEventListener('change', e => {
  document.getElementById('mediaFilename').textContent = e.target.files[0]?.name || '';
});
document.getElementById('editReviewMedia').addEventListener('change', e => {
  document.getElementById('editMediaFilename').textContent = e.target.files[0]?.name || '';
});

// Create review
document.getElementById('submitReview').addEventListener('click', async () => {
  const title   = document.getElementById('reviewTitle').value.trim();
  const rawBody = document.getElementById('reviewBody').innerHTML;
  const rating  = document.getElementById('reviewRating').value;
  const estId   = document.getElementById('reviewEstablishmentId').value;
  const file    = document.getElementById('reviewMedia').files[0];

  if (!title) return alert('Please enter a title.');
  if (!rating || rating === '0') return alert('Please select a rating.');
  if (!rawBody.trim()) return alert('Please write a review.');

  const cleanBody = DOMPurify.sanitize(rawBody, {
    ALLOWED_TAGS: ['b','i','u','s','strong','em','br','p','ul','ol','li','a'],
    ALLOWED_ATTR: ['href','target','rel']
  });

  const fd = new FormData();
  fd.append('title', title);
  fd.append('body', cleanBody);
  fd.append('rating', rating);
  fd.append('establishment', estId);
  if (file) fd.append('media', file);

  try {
    const res  = await fetch('/reviews', { method: 'POST', body: fd });
    const data = await res.json();
    if (data.success) { location.reload(); }
    else { alert(data.message || 'Failed to post review.'); }
  } catch (err) { alert('Network error.'); }
});

// Open edit modal
document.querySelectorAll('.edit-review-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.getElementById('editReviewId').value    = btn.dataset.id;
    document.getElementById('editReviewTitle').value = btn.dataset.title;
    document.getElementById('editReviewBody').innerHTML = decodeURIComponent(btn.dataset.body);
    const rating = parseInt(btn.dataset.rating);
    document.getElementById('editReviewRating').value = rating;
    document.getElementById('editRatingValueDisplay').textContent = rating + ' / 5';
    document.getElementById('editStarRating').querySelectorAll('.star').forEach(s => {
      s.style.color = parseInt(s.dataset.value) <= rating ? '#fbbf24' : '#ccc';
    });
    openModal('editReviewModal');
  });
});

// Submit edit
document.getElementById('submitEditReview').addEventListener('click', async () => {
  const id      = document.getElementById('editReviewId').value;
  const title   = document.getElementById('editReviewTitle').value.trim();
  const rawBody = document.getElementById('editReviewBody').innerHTML;
  const rating  = document.getElementById('editReviewRating').value;
  const file    = document.getElementById('editReviewMedia').files[0];

  if (!title) return alert('Please enter a title.');
  if (!rating || rating === '0') return alert('Please select a rating.');

  const cleanBody = DOMPurify.sanitize(rawBody, {
    ALLOWED_TAGS: ['b','i','u','s','strong','em','br','p','ul','ol','li','a'],
    ALLOWED_ATTR: ['href','target','rel']
  });

  const fd = new FormData();
  fd.append('title', title);
  fd.append('body', cleanBody);
  fd.append('rating', rating);
  if (file) fd.append('media', file);

  try {
    const res  = await fetch(`/reviews/${id}`, { method: 'PUT', body: fd });
    const data = await res.json();
    if (data.success) { location.reload(); }
    else { alert(data.message || 'Failed to edit review.'); }
  } catch (err) { alert('Network error.'); }
});

// Delete review
document.querySelectorAll('.delete-review-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    if (!confirm('Delete this review?')) return;
    const id = btn.dataset.id;
    try {
      const res  = await fetch(`/reviews/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) { document.querySelector(`.review-card[data-id="${id}"]`).remove(); }
      else { alert(data.message); }
    } catch (err) { alert('Network error.'); }
  });
});

// Helpful / Unhelpful votes
document.querySelectorAll('.vote-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    const id       = btn.dataset.id;
    const voteType = btn.dataset.type;
    try {
      const res  = await fetch(`/reviews/${id}/vote`, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ voteType })
      });
      const data = await res.json();
      if (!data.success) { alert(data.message); return; }

      // Update counts + active state in the card
      const card = document.querySelector(`.review-card[data-id="${id}"]`);
      const helpfulBtn   = card.querySelector('.vote-btn[data-type="helpful"]');
      const unhelpfulBtn = card.querySelector('.vote-btn[data-type="unhelpful"]');
      helpfulBtn.querySelector('.helpful-count').textContent     = data.helpfulCount;
      unhelpfulBtn.querySelector('.unhelpful-count').textContent = data.unhelpfulCount;

      helpfulBtn.className   = 'vote-btn ' + (data.userVote === 'helpful'   ? 'primary-btn' : 'secondary-btn');
      unhelpfulBtn.className = 'vote-btn ' + (data.userVote === 'unhelpful' ? 'primary-btn' : 'secondary-btn');
    } catch (err) { alert('Network error.'); }
  });
});

// Owner respond
document.querySelectorAll('.owner-respond-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.getElementById('ownerResponseReviewId').value = btn.dataset.id;
    document.getElementById('ownerResponseBody').innerHTML = '';
    openModal('ownerResponseModal');
  });
});

const submitOwnerBtn = document.getElementById('submitOwnerResponse');
if (submitOwnerBtn) {
  submitOwnerBtn.addEventListener('click', async () => {
    const id      = document.getElementById('ownerResponseReviewId').value;
    const rawBody = document.getElementById('ownerResponseBody').innerHTML;
    const cleanBody = DOMPurify.sanitize(rawBody, {
      ALLOWED_TAGS: ['b','i','u','strong','em','br','p'],
      ALLOWED_ATTR: []
    });
    if (!cleanBody.trim()) return alert('Please write a response.');
    try {
      const res  = await fetch(`/reviews/${id}/owner-response`, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({ body: cleanBody })
      });
      const data = await res.json();
      if (data.success) { location.reload(); }
      else { alert(data.message); }
    } catch (err) { alert('Network error.'); }
  });
}

// Delete owner response
document.querySelectorAll('.delete-owner-response-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    if (!confirm('Delete this response?')) return;
    const id = btn.dataset.id;
    try {
      const res  = await fetch(`/reviews/${id}/owner-response`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) { location.reload(); }
      else { alert(data.message); }
    } catch (err) { alert('Network error.'); }
  });
});

// Search filter
document.getElementById('searchInput').addEventListener('input', function () {
  const q = this.value.toLowerCase();
  document.querySelectorAll('.review-card').forEach(card => {
    const title = card.dataset.title.toLowerCase();
    const body  = card.querySelector('.review-body-preview')?.textContent.toLowerCase() || '';
    card.style.display = (title.includes(q) || body.includes(q)) ? '' : 'none';
  });
});
</script>

<script src="/js/theme-toggle.js"></script>
</body>
</html>
