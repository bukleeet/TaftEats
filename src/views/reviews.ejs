<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= establishment ? establishment.name + ' – Reviews' : 'All Reviews' %> - TaftEats</title>
  <link rel="stylesheet" href="/css/style.css"/>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/dompurify/3.1.6/purify.min.js"></script>
</head>
<body>

<%- include('navbar') %>

<div class="header" style="position:relative;">
  <h1><%= establishment ? establishment.name : 'All Reviews' %></h1>
  <p><%= establishment ? establishment.description : 'Browse all reviews' %></p>
  <% if (establishment) { %>
    <% if (establishment.image) { %>
      <img src="/images/<%= establishment.image %>" alt="<%= establishment.name %>"
           style="width:80px;height:80px;object-fit:cover;border-radius:50%;border:3px solid #16a34a;margin:0.5rem auto 0;display:block;">
    <% } %>
    <div class="star-display" data-rating="<%= establishment.rating %>"
         data-count="<%= reviews.length %>"
         style="justify-content:center;margin-top:0.5rem;"></div>
  <% } %>
  <% if (user) { %>
    <button class="review-btn" id="openReviewModal">+ Write a Review</button>
  <% } %>
</div>

<div class="container">

  <div class="search-bar">
    <input type="text" id="searchInput" placeholder="Search reviews…" />
    <select id="sortSelect" style="max-width:180px;">
      <option value="newest">Newest first</option>
      <option value="oldest">Oldest first</option>
      <option value="highest">Highest rated</option>
      <option value="lowest">Lowest rated</option>
      <option value="helpful">Most helpful</option>
      <option value="byrating">By rating…</option>
    </select>
  </div>

  <div id="ratingFilterRow" class="rating-filter-row" style="display:none;">
    <span style="font-size:0.85rem;color:#6b7280;">Show only:</span>
    <% const halfSteps = [1,1.5,2,2.5,3,3.5,4,4.5,5]; %>
    <% halfSteps.forEach(v => { %>
      <button class="rating-filter-btn" data-val="<%= v %>"><%= v %>★</button>
    <% }) %>
    <button class="rating-filter-btn" data-val="all">All</button>
  </div>

  <div id="reviewsList">
    <% if (reviews.length === 0) { %>
      <p style="color:#6b7280;margin-top:2rem;">No reviews yet. Be the first!</p>
    <% } %>

    <% reviews.forEach(review => { %>
      <div class="review-card"
           data-id="<%= review._id %>"
           data-title="<%= review.title %>"
           data-rating="<%= review.rating %>"
           data-date="<%= new Date(review.createdAt).getTime() %>"
           data-helpful="<%= review.helpfulCount %>">

        <div style="display:flex;justify-content:space-between;align-items:flex-start;">
          <div>
            <% if (!establishment && review.establishment) { %>
              <p style="font-size:0.78rem;color:#9ca3af;margin-bottom:0.2rem;font-weight:400;">
                <%= review.establishment.name %>
              </p>
            <% } %>
            <h3><%= review.title %></h3>
            <p class="review-meta">
              <span class="star-display" data-rating="<%= review.rating %>"></span>
              &nbsp;·&nbsp; @<%= review.username %> &nbsp;·&nbsp;
              <%= new Date(review.createdAt).toLocaleDateString('en-PH', { year:'numeric', month:'short', day:'numeric' }) %>
              <% if (review.edited) { %>
                <span class="edited-tag">
                  (edited)
                  <span class="edit-tooltip">Last edited <%= new Date(review.updatedAt).toLocaleDateString('en-PH', { year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' }) %></span>
                </span>
              <% } %>
            </p>
          </div>

          <div style="display:flex;gap:0.5rem;">
            <% if (user && review.isReviewer) { %>
              <button class="secondary-btn edit-review-btn"
                      data-id="<%= review._id %>"
                      data-title="<%= review.title %>"
                      data-body="<%= encodeURIComponent(review.body) %>"
                      data-rating="<%= review.rating %>"
                      data-media="<%= JSON.stringify(Array.isArray(review.media) ? review.media : []) %>">Edit</button>
              <button class="secondary-btn delete-review-btn"
                      data-id="<%= review._id %>"
                      style="color:#ef4444;">Delete</button>
            <% } %>
          </div>
        </div>

        <div class="review-text review-body-preview" style="max-height:120px;overflow:hidden;">
          <%- review.body %>
        </div>
        <a href="/reviews/<%= review._id %>" style="font-size:0.85rem;color:#16a34a;">Read full review →</a>

        <% if (review.media && Array.isArray(review.media) && review.media.length > 0) { %>
          <div class="preview-media-row">
            <% review.media.forEach(file => { %>
              <% const isVideo = /\.(mp4|mov|webm)$/i.test(file); %>
              <% if (isVideo) { %>
                <video src="/uploads/<%= file %>" controls class="preview-media-img"></video>
              <% } else { %>
                <img src="/uploads/<%= file %>" alt="Review media" class="preview-media-img">
              <% } %>
            <% }) %>
          </div>
        <% } %>

        <div style="display:flex;gap:1rem;margin-top:1rem;align-items:center;">
          <button class="vote-btn <%= review.userVote === 'helpful' ? 'primary-btn' : 'secondary-btn' %>"
            data-id="<%= review._id %>" data-type="helpful"
            <%= !user ? 'disabled title="Login to vote"' : '' %>>
            👍 Helpful (<span class="helpful-count"><%= review.helpfulCount %></span>)
          </button>
          <button class="vote-btn <%= review.userVote === 'unhelpful' ? 'primary-btn' : 'secondary-btn' %>"
            data-id="<%= review._id %>" data-type="unhelpful"
            <%= !user ? 'disabled title="Login to vote"' : '' %>>
            👎 Unhelpful (<span class="unhelpful-count"><%= review.unhelpfulCount %></span>)
          </button>
        </div>

        <% if (review.responseThread && review.responseThread.length > 0) { %>
          <div class="owner-response" style="margin-top:1rem;">
            <% review.responseThread.forEach((msg, idx) => { %>
              <%
                const canEditMsg = user && (
                  (msg.role === 'owner' && user.role === 'owner' && user.ownedEstablishment && establishment && user.ownedEstablishment.toString() === establishment._id.toString()) ||
                  (msg.role === 'reviewer' && user._id.toString() === review.user.toString())
                );
              %>
              <div style="margin-left:<%= idx > 0 ? '1.2rem' : '0' %>;margin-top:<%= idx > 0 ? '0.75rem' : '0' %>;padding-top:<%= idx > 0 ? '0.75rem' : '0' %>;<%= idx > 0 ? 'border-top:1px solid rgba(0,0,0,0.07);' : '' %>">
                <strong style="font-size:0.85rem;">
                  <%= msg.role === 'owner' ? '🏪 ' + msg.author : '💬 ' + msg.author %>
                </strong>
                <span style="font-size:0.75rem;color:#9ca3af;margin-left:0.4rem;">
                  <%= new Date(msg.createdAt).toLocaleDateString('en-PH', { year:'numeric', month:'short', day:'numeric' }) %>
                </span>
                <% if (msg.edited && msg.updatedAt) { %>
                  <span class="thread-edited-tag">(edited)<span class="edit-tooltip">Edited <%= new Date(msg.updatedAt).toLocaleDateString('en-PH', { year:'numeric', month:'short', day:'numeric', hour:'2-digit', minute:'2-digit' }) %></span></span>
                <% } %>
                <div style="margin-top:0.25rem;font-size:0.9rem;"><%- msg.body %></div>
                <% if (canEditMsg) { %>
                  <button class="thread-btn edit-thread-msg-btn" style="margin-top:0.3rem;"
                          data-reviewid="<%= review._id %>"
                          data-msgidx="<%= idx %>"
                          data-body="<%= encodeURIComponent(msg.body) %>">Edit</button>
                <% } %>
              </div>
            <% }) %>
            <%
              const lastMsg = review.responseThread[review.responseThread.length - 1];
              const isOwner = user && user.role === 'owner' && user.ownedEstablishment && establishment &&
                              user.ownedEstablishment.toString() === establishment._id.toString();
              const isReviewer = user && review.isReviewer;
            %>
            <div style="display:flex;gap:0.5rem;margin-top:0.6rem;flex-wrap:wrap;">
              <% if (isOwner && lastMsg.role === 'reviewer') { %>
                <button class="thread-btn owner-respond-btn" data-id="<%= review._id %>">💬 Reply as Owner</button>
              <% } %>
              <% if (isReviewer && lastMsg.role === 'owner') { %>
                <button class="thread-btn reviewer-reply-btn" data-id="<%= review._id %>">↩ Reply</button>
              <% } %>
              <% if ((isOwner && lastMsg.role === 'owner') || (isReviewer && lastMsg.role === 'reviewer')) { %>
                <button class="thread-btn danger delete-last-thread-btn" data-id="<%= review._id %>">Delete My Last Reply</button>
              <% } %>
            </div>
          </div>
        <% } else if (user && user.role === 'owner' && establishment && user.ownedEstablishment && user.ownedEstablishment.toString() === establishment._id.toString()) { %>
          <button class="thread-btn owner-respond-btn"
                  data-id="<%= review._id %>"
                  style="margin-top:0.75rem;">💬 Respond as Owner</button>
        <% } %>
      </div>
    <% }) %>
  </div>
</div>

<div class="modal" id="reviewModal">
  <div class="modal-card" style="max-width:560px;">
    <h3 style="color:#065f46;margin-bottom:1rem;">Write a Review</h3>
    <input type="hidden" id="reviewEstablishmentId" value="<%= establishment ? establishment._id : '' %>">
    <input class="modal-input" id="reviewTitle" placeholder="Review title" maxlength="120" style="margin-bottom:0.75rem;">
    <div class="star-rating-container" id="starRating">
      <span class="star" data-value="1">★</span>
      <span class="star" data-value="2">★</span>
      <span class="star" data-value="3">★</span>
      <span class="star" data-value="4">★</span>
      <span class="star" data-value="5">★</span>
      <span class="rating-label" id="ratingValueDisplay">0 / 5</span>
    </div>
    <input type="hidden" id="reviewRating" value="0">
    <div class="rich-editor-container" style="margin-bottom:0.75rem;">
      <div class="editor-toolbar">
        <button type="button" onclick="execCmd('bold')"><b>B</b></button>
        <button type="button" onclick="execCmd('italic')"><i>I</i></button>
        <button type="button" onclick="execCmd('underline')"><u>U</u></button>
        <button type="button" onclick="execCmd('strikeThrough')"><s>S</s></button>
        <button type="button" onclick="execCmd('insertUnorderedList')">• List</button>
        <button type="button" onclick="execCmd('insertOrderedList')">1. List</button>
      </div>
      <div class="editor-content" id="reviewBody" contenteditable="true" placeholder="Write your review here…"></div>
    </div>
    <div class="media-upload">
      <label class="upload-label" for="reviewMedia">📎 Attach photos/videos (up to 10, max 6 MB each)</label>
      <input type="file" id="reviewMedia" accept="image/*,video/*" multiple style="display:none;">
      <div id="mediaPreviewRow" class="preview-media-row" style="margin-top:0.5rem;"></div>
    </div>
    <div class="modal-actions">
      <button class="primary-btn"   id="submitReview">Post Review</button>
      <button class="secondary-btn" id="cancelReview">Cancel</button>
    </div>
  </div>
</div>

<div class="modal" id="editReviewModal">
  <div class="modal-card" style="max-width:560px;">
    <h3 style="color:#065f46;margin-bottom:1rem;">Edit Review</h3>
    <input type="hidden" id="editReviewId">
    <input class="modal-input" id="editReviewTitle" placeholder="Review title" maxlength="120" style="margin-bottom:0.75rem;">
    <div class="star-rating-container" id="editStarRating">
      <span class="star" data-value="1">★</span>
      <span class="star" data-value="2">★</span>
      <span class="star" data-value="3">★</span>
      <span class="star" data-value="4">★</span>
      <span class="star" data-value="5">★</span>
      <span class="rating-label" id="editRatingValueDisplay">0 / 5</span>
    </div>
    <input type="hidden" id="editReviewRating" value="0">
    <div class="rich-editor-container" style="margin-bottom:0.75rem;">
      <div class="editor-toolbar">
        <button type="button" onclick="execEditCmd('bold')"><b>B</b></button>
        <button type="button" onclick="execEditCmd('italic')"><i>I</i></button>
        <button type="button" onclick="execEditCmd('underline')"><u>U</u></button>
        <button type="button" onclick="execEditCmd('strikeThrough')"><s>S</s></button>
        <button type="button" onclick="execEditCmd('insertUnorderedList')">• List</button>
        <button type="button" onclick="execEditCmd('insertOrderedList')">1. List</button>
      </div>
      <div class="editor-content" id="editReviewBody" contenteditable="true"></div>
    </div>
    <div class="media-upload">
      <p style="font-size:0.85rem;color:#6b7280;margin-bottom:0.4rem;">Current photos/videos:</p>
      <div id="editExistingMedia" class="preview-media-row"></div>
      <label class="upload-label" for="editReviewMedia" style="margin-top:0.5rem;display:inline-block;">📎 Add more (up to 10 total, max 6 MB each)</label>
      <input type="file" id="editReviewMedia" accept="image/*,video/*" multiple style="display:none;">
      <div id="editNewMediaPreview" class="preview-media-row" style="margin-top:0.5rem;"></div>
    </div>
    <div class="modal-actions">
      <button class="primary-btn"   id="submitEditReview">Save Changes</button>
      <button class="secondary-btn" id="cancelEditReview">Cancel</button>
    </div>
  </div>
</div>

<div class="modal" id="ownerResponseModal">
  <div class="modal-card" style="max-width:480px;">
    <h3 id="ownerModalTitle" style="color:#065f46;margin-bottom:1rem;">Respond as Owner</h3>
    <input type="hidden" id="ownerResponseReviewId">
    <div class="rich-editor-container" style="margin-bottom:0.75rem;">
      <div class="editor-toolbar">
        <button type="button" onclick="execOwnerCmd('bold')"><b>B</b></button>
        <button type="button" onclick="execOwnerCmd('italic')"><i>I</i></button>
        <button type="button" onclick="execOwnerCmd('underline')"><u>U</u></button>
      </div>
      <div class="editor-content" id="ownerResponseBody" contenteditable="true" placeholder="Write your response…"></div>
    </div>
    <div class="modal-actions">
      <button class="primary-btn"   id="submitOwnerResponse">Post Response</button>
      <button class="secondary-btn" id="cancelOwnerResponse">Cancel</button>
    </div>
  </div>
</div>

<script>
function renderStars(rating) {
  let html = '';
  for (let i = 1; i <= 5; i++) {
    if (rating >= i)           html += '<span class="star star-filled">★</span>';
    else if (rating >= i-0.5)  html += '<span class="star half">★</span>';
    else                       html += '<span class="star">★</span>';
  }
  html += '<span style="font-size:0.9rem;color:#6b7280;margin-left:6px;">' + parseFloat(rating).toFixed(1) + ' / 5</span>';
  return html;
}
document.querySelectorAll('.star-display').forEach(el => {
  const count = el.dataset.count;
  let html = renderStars(parseFloat(el.dataset.rating));
  if (count !== undefined) {
    html += ' <span style="color:#6b7280;font-size:0.85rem;">(' + count + ' review' + (parseInt(count) !== 1 ? 's' : '') + ')</span>';
  }
  el.innerHTML = html;
});


function execCmd(cmd)      { document.execCommand(cmd, false, null); document.getElementById('reviewBody').focus(); }
function execEditCmd(cmd)  { document.execCommand(cmd, false, null); document.getElementById('editReviewBody').focus(); }
function execOwnerCmd(cmd) { document.execCommand(cmd, false, null); document.getElementById('ownerResponseBody').focus(); }

function applyHighlight(container, val) {
  container.querySelectorAll('.star').forEach(s => {
    const sv = parseFloat(s.dataset.value);
    if (val >= sv)        { s.classList.add('star-filled'); s.classList.remove('half'); }
    else if (val >= sv-0.5){ s.classList.add('half'); s.classList.remove('star-filled'); }
    else                  { s.classList.remove('star-filled','half'); }
    s.style.color = '';
  });
}

function initStars(containerId, hiddenId, displayId) {
  const container = document.getElementById(containerId);
  const hidden    = document.getElementById(hiddenId);
  const display   = document.getElementById(displayId);
  if (!container) return;
  container.querySelectorAll('.star').forEach(star => {
    star.addEventListener('mousemove', e => {
      const val = parseFloat(star.dataset.value) - (e.clientX < star.getBoundingClientRect().left + star.offsetWidth/2 ? 0.5 : 0);
      applyHighlight(container, val);
      display.textContent = val + ' / 5';
    });
    star.addEventListener('click', e => {
      const val = parseFloat(star.dataset.value) - (e.clientX < star.getBoundingClientRect().left + star.offsetWidth/2 ? 0.5 : 0);
      hidden.value = val;
      display.textContent = val + ' / 5';
      applyHighlight(container, val);
    });
    star.addEventListener('mouseleave', () => {
      const cur = parseFloat(hidden.value) || 0;
      applyHighlight(container, cur);
      display.textContent = cur + ' / 5';
    });
  });
}
initStars('starRating',     'reviewRating',     'ratingValueDisplay');
initStars('editStarRating', 'editReviewRating', 'editRatingValueDisplay');

// Sort + rating filter (multi-select)
const sortSelect      = document.getElementById('sortSelect');
const ratingFilterRow = document.getElementById('ratingFilterRow');
const activeFilters   = new Set();

sortSelect.addEventListener('change', function() {
  if (this.value === 'byrating') {
    ratingFilterRow.style.display = 'flex';
  } else {
    ratingFilterRow.style.display = 'none';
    activeFilters.clear();
    document.querySelectorAll('.rating-filter-btn').forEach(b => b.classList.remove('active'));
    applyFilterAndSort();
    sortCards(this.value);
  }
});

document.querySelectorAll('.rating-filter-btn').forEach(btn => {
  btn.addEventListener('click', function() {
    const val = this.dataset.val;
    if (val === 'all') {
      // Clear all selections
      activeFilters.clear();
      document.querySelectorAll('.rating-filter-btn').forEach(b => b.classList.remove('active'));
    } else {
      // Toggle this rating on/off
      if (activeFilters.has(val)) {
        activeFilters.delete(val);
        this.classList.remove('active');
      } else {
        activeFilters.add(val);
        this.classList.add('active');
      }
    }
    applyFilterAndSort();
  });
});

function applyFilterAndSort() {
  document.querySelectorAll('.review-card').forEach(card => {
    if (activeFilters.size === 0) {
      card.style.display = '';
    } else {
      card.style.display = activeFilters.has(card.dataset.rating) ? '' : 'none';
    }
  });
}

function sortCards(mode) {
  const list  = document.getElementById('reviewsList');
  const cards = Array.from(list.querySelectorAll('.review-card'));
  cards.sort((a, b) => {
    switch(mode) {
      case 'newest':  return b.dataset.date    - a.dataset.date;
      case 'oldest':  return a.dataset.date    - b.dataset.date;
      case 'highest': return b.dataset.rating  - a.dataset.rating;
      case 'lowest':  return a.dataset.rating  - b.dataset.rating;
      case 'helpful': return b.dataset.helpful - a.dataset.helpful;
    }
  });
  cards.forEach(c => list.appendChild(c));
}

// Modal helpers
function openModal(id)  { document.getElementById(id).classList.add('active'); }
function closeModal(id) { document.getElementById(id).classList.remove('active'); }

const openBtn = document.getElementById('openReviewModal');
if (openBtn) openBtn.addEventListener('click', () => openModal('reviewModal'));
document.getElementById('cancelReview').addEventListener('click',     () => closeModal('reviewModal'));
document.getElementById('cancelEditReview').addEventListener('click', () => closeModal('editReviewModal'));
const cancelOwner = document.getElementById('cancelOwnerResponse');
if (cancelOwner) cancelOwner.addEventListener('click', () => closeModal('ownerResponseModal'));
['reviewModal','editReviewModal','ownerResponseModal'].forEach(id => {
  const el = document.getElementById(id);
  if (el) el.addEventListener('click', e => { if (e.target === el) closeModal(id); });
});

// Multi-file preview for create modal
let createFiles = [];
document.getElementById('reviewMedia').addEventListener('change', function() {
  const incoming = Array.from(this.files);
  createFiles = createFiles.concat(incoming).slice(0, 10);
  renderCreatePreviews();
  this.value = '';
});

function renderCreatePreviews() {
  const row = document.getElementById('mediaPreviewRow');
  row.innerHTML = '';
  createFiles.forEach((file, idx) => {
    const wrap = document.createElement('div');
    wrap.className = 'media-thumb-wrap';
    const isVideo = file.type.startsWith('video/');
    const el = document.createElement(isVideo ? 'video' : 'img');
    el.src = URL.createObjectURL(file);
    el.className = 'preview-media-img';
    if (isVideo) { el.controls = true; }
    const rm = document.createElement('button');
    rm.className = 'remove-media-btn';
    rm.textContent = '×';
    rm.addEventListener('click', () => { createFiles.splice(idx, 1); renderCreatePreviews(); });
    wrap.appendChild(el);
    wrap.appendChild(rm);
    row.appendChild(wrap);
  });
}

// Create review
document.getElementById('submitReview').addEventListener('click', async () => {
  const title   = document.getElementById('reviewTitle').value.trim();
  const rawBody = document.getElementById('reviewBody').innerHTML;
  const rating  = document.getElementById('reviewRating').value;
  const estId   = document.getElementById('reviewEstablishmentId').value;

  if (!title)                    return alert('Please enter a title.');
  if (!rating || rating === '0') return alert('Please select a rating.');
  if (!rawBody.trim())           return alert('Please write a review.');

  const cleanBody = DOMPurify.sanitize(rawBody, {
    ALLOWED_TAGS: ['b','i','u','s','strong','em','br','p','ul','ol','li','a'],
    ALLOWED_ATTR: ['href','target','rel']
  });

  const fd = new FormData();
  fd.append('title', title);
  fd.append('body', cleanBody);
  fd.append('rating', rating);
  fd.append('establishment', estId);
  createFiles.forEach(f => fd.append('media', f));

  try {
    const res  = await fetch('/reviews', { method: 'POST', body: fd });
    const data = await res.json();
    if (data.success) location.reload();
    else alert(data.message || 'Failed to post review.');
  } catch { alert('Network error.'); }
});

// Edit modal — load existing media as deletable thumbs
let editDeleteList   = [];
let editNewFiles     = [];

document.querySelectorAll('.edit-review-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.getElementById('editReviewId').value       = btn.dataset.id;
    document.getElementById('editReviewTitle').value    = btn.dataset.title;
    document.getElementById('editReviewBody').innerHTML = decodeURIComponent(btn.dataset.body);
    editDeleteList = [];
    editNewFiles   = [];

    const rating = parseFloat(btn.dataset.rating);
    document.getElementById('editReviewRating').value = rating;
    document.getElementById('editRatingValueDisplay').textContent = rating + ' / 5';
    applyHighlight(document.getElementById('editStarRating'), rating);

    const existingMedia = JSON.parse(btn.dataset.media || '[]');
    renderEditExisting(existingMedia);
    document.getElementById('editNewMediaPreview').innerHTML = '';
    openModal('editReviewModal');
  });
});

function renderEditExisting(mediaArr) {
  const row = document.getElementById('editExistingMedia');
  row.innerHTML = '';
  if (!mediaArr.length) { row.innerHTML = '<span style="font-size:0.82rem;color:#6b7280;">None</span>'; return; }
  mediaArr.forEach(file => {
    if (editDeleteList.includes(file)) return;
    const wrap = document.createElement('div');
    wrap.className = 'media-thumb-wrap';
    const isVideo = /\.(mp4|mov|webm)$/i.test(file);
    const el = document.createElement(isVideo ? 'video' : 'img');
    el.src = '/uploads/' + file;
    el.className = 'preview-media-img';
    if (isVideo) el.controls = true;
    const rm = document.createElement('button');
    rm.className = 'remove-media-btn';
    rm.textContent = '×';
    rm.addEventListener('click', () => {
      editDeleteList.push(file);
      renderEditExisting(mediaArr);
    });
    wrap.appendChild(el);
    wrap.appendChild(rm);
    row.appendChild(wrap);
  });
}

document.getElementById('editReviewMedia').addEventListener('change', function() {
  const incoming = Array.from(this.files);
  editNewFiles = editNewFiles.concat(incoming).slice(0, 10);
  renderEditNewPreviews();
  this.value = '';
});

function renderEditNewPreviews() {
  const row = document.getElementById('editNewMediaPreview');
  row.innerHTML = '';
  editNewFiles.forEach((file, idx) => {
    const wrap = document.createElement('div');
    wrap.className = 'media-thumb-wrap';
    const isVideo = file.type.startsWith('video/');
    const el = document.createElement(isVideo ? 'video' : 'img');
    el.src = URL.createObjectURL(file);
    el.className = 'preview-media-img';
    if (isVideo) el.controls = true;
    const rm = document.createElement('button');
    rm.className = 'remove-media-btn';
    rm.textContent = '×';
    rm.addEventListener('click', () => { editNewFiles.splice(idx, 1); renderEditNewPreviews(); });
    wrap.appendChild(el);
    wrap.appendChild(rm);
    row.appendChild(wrap);
  });
}

document.getElementById('submitEditReview').addEventListener('click', async () => {
  const id      = document.getElementById('editReviewId').value;
  const title   = document.getElementById('editReviewTitle').value.trim();
  const rawBody = document.getElementById('editReviewBody').innerHTML;
  const rating  = document.getElementById('editReviewRating').value;

  if (!title)                    return alert('Please enter a title.');
  if (!rating || rating === '0') return alert('Please select a rating.');

  const cleanBody = DOMPurify.sanitize(rawBody, {
    ALLOWED_TAGS: ['b','i','u','s','strong','em','br','p','ul','ol','li','a'],
    ALLOWED_ATTR: ['href','target','rel']
  });

  const fd = new FormData();
  fd.append('title', title);
  fd.append('body', cleanBody);
  fd.append('rating', rating);
  editDeleteList.forEach(f => fd.append('deleteMedia', f));
  editNewFiles.forEach(f => fd.append('media', f));

  try {
    const res  = await fetch(`/reviews/${id}`, { method: 'PUT', body: fd });
    const data = await res.json();
    if (data.success) location.reload();
    else alert(data.message || 'Failed to edit review.');
  } catch { alert('Network error.'); }
});

// Delete review
document.querySelectorAll('.delete-review-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    if (!confirm('Delete this review?')) return;
    const id = btn.dataset.id;
    try {
      const res  = await fetch(`/reviews/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) { document.querySelector(`.review-card[data-id="${id}"]`).remove(); }
      else alert(data.message);
    } catch { alert('Network error.'); }
  });
});

// Votes
document.querySelectorAll('.vote-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    const id = btn.dataset.id, voteType = btn.dataset.type;
    try {
      const res  = await fetch(`/reviews/${id}/vote`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ voteType })
      });
      const data = await res.json();
      if (!data.success) { alert(data.message); return; }
      const card = document.querySelector(`.review-card[data-id="${id}"]`);
      const hBtn  = card.querySelector('.vote-btn[data-type="helpful"]');
      const uhBtn = card.querySelector('.vote-btn[data-type="unhelpful"]');
      hBtn.className  = 'vote-btn ' + (data.userVote === 'helpful'   ? 'primary-btn' : 'secondary-btn');
      uhBtn.className = 'vote-btn ' + (data.userVote === 'unhelpful' ? 'primary-btn' : 'secondary-btn');
      hBtn.innerHTML  = '👍 Helpful (<span class="helpful-count">'   + data.helpfulCount   + '</span>)';
      uhBtn.innerHTML = '👎 Unhelpful (<span class="unhelpful-count">' + data.unhelpfulCount + '</span>)';
      card.dataset.helpful = data.helpfulCount;
    } catch { alert('Network error.'); }
  });
});

// Response thread
let threadReviewId  = null;
let threadEndpoint  = null; // the URL to POST to

document.querySelectorAll('.owner-respond-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    threadReviewId = btn.dataset.id;
    threadEndpoint = `/reviews/${threadReviewId}/owner-response`;
    document.getElementById('ownerModalTitle').textContent = 'Respond as Owner';
    document.getElementById('ownerResponseBody').innerHTML = '';
    openModal('ownerResponseModal');
  });
});

document.querySelectorAll('.reviewer-reply-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    threadReviewId = btn.dataset.id;
    threadEndpoint = `/reviews/${threadReviewId}/reviewer-reply`;
    document.getElementById('ownerModalTitle').textContent = 'Reply to Owner';
    document.getElementById('ownerResponseBody').innerHTML = '';
    openModal('ownerResponseModal');
  });
});

document.querySelectorAll('.delete-last-thread-btn').forEach(btn => {
  btn.addEventListener('click', async () => {
    if (!confirm('Delete your last message in this thread?')) return;
    try {
      const res  = await fetch(`/reviews/${btn.dataset.id}/thread-last-message`, { method: 'DELETE' });
      const data = await res.json();
      if (data.success) location.reload();
      else alert(data.message);
    } catch { alert('Network error.'); }
  });
});

const submitOwnerBtn = document.getElementById('submitOwnerResponse');
if (submitOwnerBtn) {
  submitOwnerBtn.addEventListener('click', async () => {
    const cleanBody = DOMPurify.sanitize(document.getElementById('ownerResponseBody').innerHTML, {
      ALLOWED_TAGS: ['b','i','u','strong','em','br','p'], ALLOWED_ATTR: []
    });
    if (!cleanBody.trim()) return alert('Please write something first.');
    try {
      const res  = await fetch(threadEndpoint, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ body: cleanBody })
      });
      const data = await res.json();
      if (data.success) location.reload();
      else alert(data.message);
    } catch { alert('Network error.'); }
  });
}

// Edit thread message (inline)
document.querySelectorAll('.edit-thread-msg-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    const reviewId = btn.dataset.reviewid;
    const msgIdx   = btn.dataset.msgidx;
    const existing = btn.closest('div').querySelector('.thread-inline-editor');
    if (existing) { existing.remove(); btn.textContent = 'Edit'; return; }
    btn.textContent = 'Cancel';
    const editor = document.createElement('div');
    editor.className = 'thread-inline-editor';
    editor.style.cssText = 'margin-top:0.5rem;';
    const ta = document.createElement('div');
    ta.contentEditable = true;
    ta.innerHTML = decodeURIComponent(btn.dataset.body);
    ta.style.cssText = 'border:1px solid #d1fae5;border-radius:8px;padding:8px;min-height:60px;font-size:0.9rem;outline:none;background:white;';
    const saveBtn = document.createElement('button');
    saveBtn.className = 'thread-btn';
    saveBtn.textContent = 'Save';
    saveBtn.style.marginTop = '0.4rem';
    saveBtn.addEventListener('click', async () => {
      const cleanBody = DOMPurify.sanitize(ta.innerHTML, {
        ALLOWED_TAGS: ['b','i','u','strong','em','br','p','div','ul','ol','li'], ALLOWED_ATTR: []
      });
      if (!cleanBody.trim()) return alert('Cannot save empty message.');
      try {
        const res  = await fetch(`/reviews/${reviewId}/thread-message/${msgIdx}`, {
          method: 'PUT', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ body: cleanBody })
        });
        const data = await res.json();
        if (data.success) location.reload();
        else alert(data.message);
      } catch { alert('Network error.'); }
    });
    editor.appendChild(ta);
    editor.appendChild(saveBtn);
    btn.insertAdjacentElement('afterend', editor);
    ta.focus();
  });
});

// Search filter
document.getElementById('searchInput').addEventListener('input', function() {
  const q = this.value.toLowerCase();
  document.querySelectorAll('.review-card').forEach(card => {
    const title = card.dataset.title.toLowerCase();
    const body  = card.querySelector('.review-body-preview')?.textContent.toLowerCase() || '';
    card.style.display = (title.includes(q) || body.includes(q)) ? '' : 'none';
  });
 
});
</script>

<script src="/js/theme-toggle.js"></script>
