NODE_ENV=development
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/tafteats_dev?replicaSet=rs0
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
# Set to 1 only when deployed behind the trusted reverse proxy (e.g. Vercel).
TRUST_PROXY=0
# Optional: omit all three to disable media uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
